  P.Field{+number, value} = field
  choose_PB_kit_fixture_Fixture_1(U32.is_eq(number, 1), number, value, cur, size)

def choose(field: P.Field, box: Msg, size: U32) -> Act:
  match box:
    case Box_PB_kit_common_Child{v}: choose_PB_kit_common_Child(field, v, size)
    case Box_PB_kit_fixture_Fixture{v}: choose_PB_kit_fixture_Fixture(field, v, size)
    case Box_PB_kit_fixture_Fixture_LabelsEntry{v}: choose_PB_kit_fixture_Fixture_LabelsEntry(field, v, size)
    case Box_PB_kit_fixture_Fixture_Detail{v}: choose_PB_kit_fixture_Fixture_Detail(field, v, size)
    case Box_PB_kit_fixture_Fixture_IndexedEntry{v}: choose_PB_kit_fixture_Fixture_IndexedEntry(field, v, size)
    case Box_PB_kit_fixture_Fixture_SwitchesEntry{v}: choose_PB_kit_fixture_Fixture_SwitchesEntry(field, v, size)
    case Box_PB_kit_fixture_Fixture_BuffersEntry{v}: choose_PB_kit_fixture_Fixture_BuffersEntry(field, v, size)
    case Box_PB_kit_fixture_Fixture_Entry{v}: choose_PB_kit_fixture_Fixture_Entry(field, v, size)
    case Box_PB_kit_fixture_Peer{v}: choose_PB_kit_fixture_Peer(field, v, size)
    case Box_PB_kit_fixture_Scalars{v}: choose_PB_kit_fixture_Scalars(field, v, size)
    case Box_PB_kit_fixture_A_0{v}: choose_PB_kit_fixture_A_0(field, v, size)
    case Box_PB_kit_fixture_A_0_B{v}: choose_PB_kit_fixture_A_0_B(field, v, size)
    case Box_PB_kit_fixture_A{v}: choose_PB_kit_fixture_A(field, v, size)
    case Box_PB_kit_fixture_A__0B{v}: choose_PB_kit_fixture_A__0B(field, v, size)

def decode_go(+depth: Nat, +size: U32, fields: List<&1, P.Field>, cur: Msg) -> Result<&2, &1, P.Error, Msg>:
  match depth:
    case 0n:
      match fields:
        case Nil{}: Done{cur}
        case Con{h, t}:
          run_act(choose(h, cur, size), False{}, size, 0n, fields => seed => Fail{P.Limit{}}, next => decode_go(0n, size, t, next))
    case 1n+p:
      match fields:
        case Nil{}: Done{cur}
        case Con{h, t}:
          run_act(choose(h, cur, size), True{}, size, p, fields => seed => decode_go(p, size, fields, seed), next => decode_go(1n+p, size, t, next))

def decode_PB_kit_common_Child(b: B.Bytes, +size: U32, +depth: Nat) -> Result<&2, &1, P.Error, PB_kit_common_Child>:
  B.Bytes{+n, buf} = b
  do Result<&2, &1, P.Error, PB_kit_common_Child>:
    fields : List<&1, P.Field> <- P.decode(B.Bytes{n, buf}, size, depth)
    raw : Msg <- decode_go(depth, size, fields, Box_PB_kit_common_Child{PB_kit_common_Child.empty()})
    box : Msg <- finish_go(Succ{U32.to_nat(n)}, finish_msg(raw), Nil{})
    cast_PB_kit_common_Child(box)

def decode_PB_kit_fixture_Fixture(b: B.Bytes, +size: U32, +depth: Nat) -> Result<&2, &1, P.Error, PB_kit_fixture_Fixture>:
