def encode_PB_kit_common_Child(cur: PB_kit_common_Child, +size: U32, +depth: Nat) -> Result<&2, &1, P.Error, B.Bytes>:
  encode_result(start_jobs(jobs_PB_kit_common_Child(cur, size), jobs => encode_go(depth, size, jobs, Nil{})), size, depth)

