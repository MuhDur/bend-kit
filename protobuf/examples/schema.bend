def finish_go(fuel: Nat, step: Final, stack: List<&1, Msg -> Final>) -> Result<&2, &1, P.Error, Msg>:
  match fuel:
    case 0n: Fail{P.Limit{}}
    case 1n+p:
      match step:
        case BadFinal{e}: Fail{e}
        case Visit{v, resume}: finish_go(p, finish_msg(v), Con{resume, stack})
        case Complete{v}: finish_complete(stack, v, next => rest => finish_go(p, next, rest))

def jobs_msg(box: Msg, size: U32) -> Result<&2, &1, P.Error, List<&1, Job>>:
  match box:
    case Box_PB_kit_common_Child{v}: jobs_PB_kit_common_Child(v, size)
    case Box_PB_kit_fixture_Fixture{v}: jobs_PB_kit_fixture_Fixture(v, size)
    case Box_PB_kit_fixture_Fixture_LabelsEntry{v}: jobs_PB_kit_fixture_Fixture_LabelsEntry(v, size)
    case Box_PB_kit_fixture_Fixture_Detail{v}: jobs_PB_kit_fixture_Fixture_Detail(v, size)
    case Box_PB_kit_fixture_Fixture_IndexedEntry{v}: jobs_PB_kit_fixture_Fixture_IndexedEntry(v, size)
    case Box_PB_kit_fixture_Fixture_SwitchesEntry{v}: jobs_PB_kit_fixture_Fixture_SwitchesEntry(v, size)
    case Box_PB_kit_fixture_Fixture_BuffersEntry{v}: jobs_PB_kit_fixture_Fixture_BuffersEntry(v, size)
    case Box_PB_kit_fixture_Fixture_Entry{v}: jobs_PB_kit_fixture_Fixture_Entry(v, size)
    case Box_PB_kit_fixture_Peer{v}: jobs_PB_kit_fixture_Peer(v, size)
    case Box_PB_kit_fixture_Scalars{v}: jobs_PB_kit_fixture_Scalars(v, size)
    case Box_PB_kit_fixture_A_0{v}: jobs_PB_kit_fixture_A_0(v, size)
    case Box_PB_kit_fixture_A_0_B{v}: jobs_PB_kit_fixture_A_0_B(v, size)
    case Box_PB_kit_fixture_A{v}: jobs_PB_kit_fixture_A(v, size)
    case Box_PB_kit_fixture_A__0B{v}: jobs_PB_kit_fixture_A__0B(v, size)

