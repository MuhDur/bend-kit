def encode_go(+depth: Nat, +size: U32, jobs: List<&1, Job>, acc: List<&1, P.Field>) -> Result<&2, &1, P.Error, List<&1, P.Field>>:
  match depth:
    case 0n:
      match jobs:
        case Nil{}: Done{List.reverse(&1, P.Field, acc)}
        case Con{h, t}:
          match h:
            case Plain{field}: encode_go(0n, size, t, Con{field, acc})
            case Child{number, v}: Fail{P.Limit{}}
    case 1n+p:
      match jobs:
        case Nil{}: Done{List.reverse(&1, P.Field, acc)}
        case Con{h, t}:
          match h:
            case Plain{field}: encode_go(1n+p, size, t, Con{field, acc})
            case Child{number, v}: start_jobs(jobs_msg(v, size), child_jobs => encode_child(encode_go(p, size, child_jobs, Nil{}), size, p, b => encode_go(1n+p, size, t, Con{P.Field{number, P.Blob{b}}, acc})))

