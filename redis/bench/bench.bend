# RESP decode benchmark: decode every reply in one fixed recording (see README.md).
import Base
import ../redis.bend as R
import bend-kit-bytes@0.3.3.0/bytes.bend as Bytes

def m(+h: U32, +x: U32) -> U32:
  (h * 31 + x : U32)

def str.go(n: Nat, r: Array<U32> & U32, +i: U32, +h: U32) -> U32:
  match n:
    case 0n:
      h
    case 1n+p:
      (a, +b) = r
      str.go(p, Bytes.peek(a, (i + 1 : U32)), (i + 1 : U32), m(h, b))

def str(+h: U32, t: Bytes.Bytes) -> U32:
  Bytes.Bytes{+len, buf} = t
  str.go(U32.to_nat(len), Bytes.peek(buf, 0), 0, m(m(h, 1), len))

# The pre-order checksum in run.py.
def walk(xs: List<&1, R.Val>, +h: U32) -> U32:
  match xs:
    case Nil{}:
      h
    case Con{R.Simple{t}, rest}:
      walk(rest, str(h, t))
    case Con{R.Bulk{t}, rest}:
      walk(rest, str(h, t))
    case Con{R.Int{hi, +lo}, rest}:
      walk(rest, m(m(h, 2), lo))
    case Con{R.Null{}, rest}:
      walk(rest, m(h, 3))
    case Con{R.Boolean{v}, rest}:
      walk(rest, m(m(h, 8), Bool.pick(U32, v, 1, 0)))
    case Con{R.Arr{items}, rest}:
      walk(rest, m(walk(items, m(h, 4)), 5))
    case Con{R.Dict{items}, rest}:
      walk(rest, m(walk(items, m(h, 6)), 7))
    # The recording holds no other type, so one here spoils the checksum.
    case Con{v, rest}:
      walk(rest, 0)

def piece(rd: R.Reader, r: Bytes.Bytes & Bytes.Bytes) -> Maybe<&1, Bytes.Bytes & R.Reader & R.Next>:
  (whole, p) = r
  Some{(whole, R.next(R.feed(rd, p)))}

# The next 64 KiB piece fed and decoded, or None past the end.
def more(last: Bool, whole: Bytes.Bytes, +at: U32, rd: R.Reader) -> Maybe<&1, Bytes.Bytes & R.Reader & R.Next>:
  match last:
    case True{}:
      None{}
    case False{}:
      piece(rd, Bytes.slice(whole, at, 65536))

# Feeds the recording to a Reader 64 KiB at a time, as a socket would, taking every whole reply
# after each piece. Replies come back newest first. Each step takes a reply or a piece, so
# len / 3 + len / 65536 + 2 steps are enough.
def pump(n: Nat, st: Maybe<&1, Bytes.Bytes & R.Reader & R.Next>, +len: U32, +at: U32, acc: List<&1, R.Val>, +k: U32) -> List<&1, R.Val> & U32:
  match n:
    case 0n:
      (acc, k)
    case 1n+p:
      match st:
        case None{}:
          (acc, k)
        case Some{(whole, rd, nx)}:
          match nx:
            case R.Got{v}:
              pump(p, Some{(whole, R.next(rd))}, len, at, Con{v, acc}, (k + 1 : U32))
            case R.Broken{}:
              (Nil{}, 0)
            case R.Want{}:
              pump(p, more(U32.is_le(len, at), whole, at, rd), len, (at + 65536 : U32), acc, k)

def lap(t0: Nat, t1: Nat, +sum: U32) -> IO(Unit):
  IO.print("decode\t" ++ Nat.show((t1 - t0 : Nat)) ++ "\t" ++ U32.show(sum))

def summed(t0: Nat, r: List<&1, R.Val> & U32) -> IO(Unit):
  (xs, +k) = r
  do IO<Unit>:
    t1 : Nat <- IO.now()
    lap(t0, t1, (walk(List.reverse(&1, R.Val, xs), 0) + k : U32))

def start(b: Bytes.Bytes) -> IO(Unit):
  Bytes.Bytes{+len, buf} = b
  do IO<Unit>:
    t0 : Nat <- IO.now()
    summed(t0, pump(U32.to_nat((len / 3 + len / 65536 + 2 : U32)), Some{(Bytes.Bytes{len, buf}, (R.reader(), R.Want{}))}, len, 0, Nil{}, 0))

def octets(xs: List<&2, U32>) -> String:
  match xs:
    case Nil{}:
      SNil{}
    case Con{c, t}:
      SCon{Chr{c}, octets(t)}

def list(r: Result<&1, &1, U32 & String, List<&2, U32>>) -> List<&2, U32>:
  match r:
    case Fail{e}:
      Nil{}
    case Done{xs}:
      xs

# The file is packed into Bytes before the timer starts.
def read(m: File & Result<&1, &1, U32 & String, List<&2, U32>>) -> IO(Unit):
  (f, r) = m
  do IO<Unit>:
    File.close(f)
    start(Bytes.from_string(octets(list(r))))

def opened(r: Result<&1, &1, U32 & String, File>) -> IO(Unit):
  match r:
    case Fail{e}:
      IO.print("open\t0\tfailed")
    case Done{f}:
      do IO<Unit>:
        m : File & Result<&1, &1, U32 & String, List<&2, U32>> <- File.read_bytes(f, 67108864)
        read(m)

def main() -> IO(Unit):
  do IO<Unit>:
    f : Result<&1, &1, U32 & String, File> <- File.open("out/replies.resp", "r")
    opened(f)
